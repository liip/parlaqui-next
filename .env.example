# Path of the SQLite database file, created with its directory on first start. Defaults to
# data/parlaqui.db; the Docker image sets /data/parlaqui.db, which must be a persistent volume.
DATABASE_PATH=

# Public origin of the site (e.g. https://parlaqui.ch); requests on any other host are redirected
# to it. Leave empty in local development.
ORIGIN=

# API key for the Swiss Parliament Open Data Web Service (https://ws.parl.ch), used by the roster
# import and scripts/parl-probe.ts; request one at https://ws.parl.ch/registration
PARL_API_KEY=

# Optional: rokka API key of the parlaqui organisation. With it, each published roster import
# uploads the portraits that changed on parlament.ch to rokka, and the game serves those copies.
# Without it, the game uses rokka's remote copies, which rokka fetches once and never refreshes.
ROKKA_API_KEY=

# Bearer token that guards POST /api/import, 32 characters or more, or the route answers 404.
# Generate one with: openssl rand -hex 24
IMPORT_TOKEN=

# Bearer token that guards GET /api/insights (visitors, page views and games per day), 32 characters
# or more, or the route answers 404. Generate one with: openssl rand -hex 24
INSIGHTS_TOKEN=

# adapter-node: where to read the visitor's address, for deployments behind a reverse proxy only.
# Leave them commented out without a proxy: the header would be missing and every request would
# fall back to one shared address. Production behind the platform's reverse proxy must set them, otherwise
# every visitor shares the proxy's address in the game's flood protection.
# ADDRESS_HEADER=X-Forwarded-For
# XFF_DEPTH=1
